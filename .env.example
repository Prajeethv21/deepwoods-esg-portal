# App Server
PORT=4000
AUTH_TOKEN_SECRET=
APP_LOGIN_EMAIL=client@deepwoods.in
APP_LOGIN_PASSWORD=password123

# Storage provider selection: supabase | google-drive | cloudinary | auto
STORAGE_PROVIDER=supabase

# Google Drive + Google Sheets (preferred)
# Paste full JSON object in one line. Keep escaped \n characters in private_key.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEET_ID=

# Supabase fallback
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_BUCKET=

# Cloudinary fallback
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
